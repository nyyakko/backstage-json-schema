{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nyyakko/backstage-json-schema/master/latest/template.v1beta3.schema.json",
  "description": "A Template describes a scaffolding task for use with the Scaffolder. It describes the required parameters as well as a series of steps that will be taken to execute the scaffolding task.",
  "examples": [
    {
      "apiVersion": "scaffolder.backstage.io/v1beta3",
      "kind": "Template",
      "metadata": {
        "name": "react-ssr-template",
        "title": "React SSR Template",
        "description": "Next.js application skeleton for creating isomorphic web applications.",
        "tags": ["recommended", "react"]
      },
      "spec": {
        "owner": "artist-relations-team",
        "type": "website",
        "lifecycle": "production",
        "parameters": {
          "required": ["name", "description", "repoUrl"],
          "backstage:permissions": {
            "tags": ["one", "two"]
          },
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "description": "Unique name of the component"
            },
            "description": {
              "title": "Description",
              "type": "string",
              "description": "Description of the component"
            },
            "repoUrl": {
              "title": "Pick a repository",
              "type": "string",
              "ui:field": "RepoUrlPicker"
            }
          }
        },
        "steps": [
          {
            "id": "fetch",
            "name": "Fetch",
            "action": "fetch:plain",
            "parameters": {
              "url": "./template"
            },
            "backstage:permissions": {
              "tags": ["one", "two"]
            }
          },
          {
            "id": "publish",
            "name": "Publish to GitHub",
            "action": "publish:github",
            "parameters": {
              "repoUrl": "${{ parameters.repoUrl }}"
            },
            "if": "${{ parameters.repoUrl }}"
          }
        ],
        "output": {
          "catalogInfoUrl": "${{ steps.publish.output.catalogInfoUrl }}"
        }
      }
    }
  ],
  "allOf": [
    {
      "$ref": "/nyyakko/backstage-json-schema/master/latest/entity.schema.json"
    },
    {
      "type": "object",
      "required": ["spec"],
      "properties": {
        "apiVersion": {
          "enum": ["scaffolder.backstage.io/v1beta3"]
        },
        "kind": {
          "enum": ["Template"]
        },
        "spec": {
          "type": "object",
          "required": ["type", "steps"],
          "properties": {
            "type": {
              "type": "string",
              "description": "The type of component created by the template. The software catalog accepts any type value, but an organization should take great care to establish a proper taxonomy for these. Tools including Backstage itself may read this field and behave differently depending on its value. For example, a website type component may present tooling in the Backstage interface that is specific to just websites.",
              "examples": ["service", "website", "library"],
              "minLength": 1
            },
            "owner": {
              "type": "string",
              "description": "The user (or group) owner of the template",
              "minLength": 1
            },
            "lifecycle": {
              "type": "string",
              "description": "The lifecycle state of the template.",
              "examples": ["experimental", "production", "deprecated"],
              "minLength": 1
            },
            "parameters": {
              "type": "array",
              "description": "A list of separate forms to collect parameters.",
              "items": {
                "type": "object",
                "description": "The JSONSchema describing the inputs for the template.",
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "The title of the component."
                  },
                  "description": {
                    "type": "string",
                    "description": "The description of the component."
                  },
                  "required": {
                    "type": "array",
                    "description": "A list of required fields."
                  },
                  "properties": {
                    "type": "object",
                    "description": "A list of separate fields used to collect values for this form.",
                    "additionalProperties": {
                      "$ref": "#/$defs/property"
                    }
                  },
                  "dependencies": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "allOf": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": ["if", "then"],
                            "properties": {
                              "if": {
                                "type": "object",
                                "required": ["properties"],
                                "properties": {
                                  "properties": {
                                    "type": "object",
                                    "additionalProperties": {
                                      "type": "object",
                                      "properties": {
                                        "const": {
                                          "description": "The value that is to be held by the property.",
                                          "type": ["integer", "string", "number", "array", "boolean"]
                                        }
                                      }
                                    }
                                  }
                                }
                              },
                              "then": {
                                "type": "object",
                                "required": ["properties"],
                                "properties": {
                                  "properties": {
                                    "type": "object",
                                    "additionalProperties": {
                                      "$ref": "#/$defs/property"
                                    }
                                  },
                                  "required": {
                                    "type": "array",
                                    "items": {
                                      "type": "string"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "ui:order": {
                    "type": "array",
                    "description": "Used to control the order of the fields in the form.",
                    "items": {
                      "type": "string"
                    }
                  },
                  "backstage:permissions": {
                    "type": "object",
                    "description": "Object used for authorizing the parameter",
                    "properties": {
                      "tags": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "secrets": {
              "type": "object",
              "description": "Configuration for secrets that are passed during task creation.",
              "properties": {
                "schema": {
                  "type": "object",
                  "description": "A JSONSchema for validating secrets passed during task creation."
                }
              }
            },
            "presentation": {
              "type": "object",
              "description": "A way to redefine the presentation of the scaffolder.",
              "properties": {
                "buttonLabels": {
                  "type": "object",
                  "description": "A way to redefine the labels for actionable buttons.",
                  "properties": {
                    "backButtonText": {
                      "type": "string",
                      "description": "A button which return the user to one step back."
                    },
                    "createButtonText": {
                      "type": "string",
                      "description": "A button which start the execution of the template."
                    },
                    "reviewButtonText": {
                      "type": "string",
                      "description": "A button which open the review step to verify the input prior to start the execution."
                    }
                  }
                }
              }
            },
            "EXPERIMENTAL_recovery": {
              "type": "object",
              "description": "A task recovery section.",
              "properties": {
                "EXPERIMENTAL_strategy": {
                  "type": "string",
                  "description": "Recovery strategy for your task (none or startOver). By default none"
                }
              }
            },
            "formDecorators": {
              "type": "array",
              "description": "A list of decorators and their inputs that the form should trigger before submitting the job",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The form decorator ID"
                  },
                  "input": {
                    "type": "object",
                    "description": "An object describing the inputs to the form decorator."
                  }
                }
              }
            },
            "EXPERIMENTAL_formDecorators": {
              "type": "array",
              "deprecated": true,
              "description": "Deprecated, use formDecorators instead.",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The form decorator ID"
                  },
                  "input": {
                    "type": "object",
                    "description": "An object describing the inputs to the form decorator."
                  }
                }
              }
            },
            "steps": {
              "type": "array",
              "description": "A list of steps to execute.",
              "items": {
                "type": "object",
                "description": "A description of the step to execute.",
                "required": ["action"],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The ID of the step, which can be used to refer to its outputs."
                  },
                  "name": {
                    "type": "string",
                    "description": "The name of the step, which will be displayed in the UI during the scaffolding process."
                  },
                  "action": {
                    "type": "string",
                    "description": "The name of the action to execute."
                  },
                  "input": {
                    "type": "object",
                    "description": "A templated object describing the inputs to the action."
                  },
                  "if": {
                    "type": ["string", "boolean"],
                    "description": "A templated condition that skips the step when evaluated to false. If the condition is true or not defined, the step is executed. The condition is true, if the input is not `false`, `undefined`, `null`, `\"\"`, `0`, or `[]`."
                  },
                  "backstage:permissions": {
                    "type": "object",
                    "description": "Object used for authorizing the step",
                    "properties": {
                      "tags": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "output": {
              "type": "object",
              "description": "A templated object describing the outputs of the scaffolding task.",
              "properties": {
                "links": {
                  "type": "array",
                  "description": "A list of external hyperlinks, typically pointing to resources created or updated by the template",
                  "items": {
                    "type": "object",
                    "required": [],
                    "properties": {
                      "if": {
                        "type": ["string", "boolean"],
                        "description": "A templated condition that excludes this link when evaluated to false. If the condition is true or not defined, the link is included. The condition is true, if the input is not `false`, `undefined`, `null`, `\"\"`, `0`, or `[]`."
                      },
                      "url": {
                        "type": "string",
                        "description": "A url in a standard uri format.",
                        "examples": ["https://github.com/my-org/my-new-repo"],
                        "minLength": 1
                      },
                      "entityRef": {
                        "type": "string",
                        "description": "An entity reference to an entity in the catalog.",
                        "examples": ["Component:default/my-app"],
                        "minLength": 1
                      },
                      "title": {
                        "type": "string",
                        "description": "A user friendly display name for the link.",
                        "examples": ["View new repo"],
                        "minLength": 1
                      },
                      "icon": {
                        "type": "string",
                        "description": "A key representing a visual icon to be displayed in the UI.",
                        "examples": ["dashboard"],
                        "minLength": 1
                      }
                    }
                  }
                },
                "text": {
                  "type": "array",
                  "description": "A list of Markdown text blobs, like output data from the template.",
                  "items": {
                    "type": "object",
                    "required": [],
                    "properties": {
                      "if": {
                        "type": ["string", "boolean"],
                        "description": "A templated condition that excludes this text when evaluated to false. If the condition is true or not defined, the text is included. The condition is true, if the input is not `false`, `undefined`, `null`, `\"\"`, `0`, or `[]`."
                      },
                      "title": {
                        "type": "string",
                        "description": "A user friendly display name for the text.",
                        "examples": ["Output Content"],
                        "minLength": 1
                      },
                      "icon": {
                        "type": "string",
                        "description": "A key representing a visual icon to be displayed in the UI.",
                        "examples": ["dashboard"],
                        "minLength": 1
                      },
                      "content": {
                        "type": "string",
                        "description": "The text blob to display in the UI, rendered as Markdown.",
                        "examples": ["**hey** _I'm_ Markdown"]
                      }
                    }
                  }
                }
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "property": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The title of the field."
        },
        "type": {
          "type": "string",
          "description": "The type of the field.",
          "enum": ["string", "number", "integer", "boolean", "array", "object"]
        },
        "description": {
          "type": "string",
          "description": "The description of the field."
        },
        "ui:field": {
          "type": "string",
          "enum": [
            "EntityNamePicker",
            "EntityPicker",
            "MultiEntityPicker",
            "OwnedEntityPicker",
            "OwnerPicker",
            "RepoBranchPicker",
            "RepoUrlPicker",
            "Secret",
            "SelectFieldFromApi"
          ]
        },
        "ui:autofocus": {
          "type": "boolean",
          "description": "Sets whatever the field will be focused by default."
        },
        "ui:help": {
          "type": "string",
          "description": "The help message displayed on hover."
        },
        "ui:disabled": {
          "type": "boolean",
          "description": "Sets whatever the field is disabled or not."
        },
        "ui:readonly": {
          "type": "boolean",
          "description": "Sets whatever the field is readonly or not."
        },
        "ui:widget": {
          "type": "string",
          "description": "The type of widget that will be rendered."
        },
        "ui:options": {
          "type": "object",
          "description": "Options to be passed to the field.",
          "additionalProperties": true
        }
      },
      "anyOf": [
        {
          "if": {
            "properties": {
              "type": { "const": "string" }
            }
          },
          "then": {
            "properties": {
              "ui:placeholder": {
                "type": "string",
                "description": "The placeholder value of the field."
              },
              "ui:options": {
                "type": "object",
                "properties": {
                  "inputType": {
                    "type": "string",
                    "description": "Specifies the native HTML <input> type attribute (e.g., text, password, email, tel) to control browser validation and keyboard layouts."
                  },
                  "label": {
                    "type": "boolean",
                    "default": true,
                    "description": "A boolean flag to toggle the visibility of the field's text label on the form."
                  },
                  "emptyValue": {
                    "type": "string",
                    "default": "",
                    "description": "The fallback value to be bound and submitted when the user completely clears the input field."
                  }
                }
              },
              "ui:widget": {
                "enum": ["textarea", "password", "color", "hidden", "radio"]
              },
              "format": {
                "enum": ["email", "uri", "data-uri", "data-url", "date", "date-time"]
              },
              "pattern": {
                "type": "string",
                "description": "Regex pattern used for validation.",
                "examples": ["'^[a-z0-9]+(-[a-z0-9]+)*$'"]
              }
            },
            "anyOf": [
              {
                "if": {
                  "properties": {
                     "ui:widget": { "const": "textarea" }
                  }
                },
                "then": {
                  "properties": {
                    "ui:options": {
                      "type": "object",
                      "properties": {
                        "rows": {
                          "type": "integer",
                          "description": "An integer that sets the initial visible height (number of text lines) of the textarea container."
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "boolean" }
            }
          },
          "then": {
            "properties": {
              "ui:placeholder": {
                "type": "boolean",
                "description": "The placeholder value of the field."
              },
              "ui:widget": {
                "enum": ["radio", "select", "hidden"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "enum": ["number", "integer"] }
            }
          },
          "then": {
            "properties": {
              "ui:placeholder": {
                "type": ["number", "integer"],
                "description": "The placeholder value of the field."
              },
              "ui:widget": {
                "enum": ["updown", "range", "maximum", "radio", "hidden"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "array" }
            }
          },
          "then": {
            "properties": {
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "The title of the item."
                  },
                  "type": {
                    "description": "The type of the item.",
                    "enum": ["string", "number", "integer", "boolean", "array", "object"]
                  }
                },
                "anyOf": [
                  {
                    "if": {
                      "properties": {
                        "type": { "const": "object" }
                      }
                    },
                    "then": {
                      "properties": {
                        "required": {
                          "type": "array",
                          "description": "A list of required fields."
                        },
                        "properties": {
                          "additionalProperties": {
                            "$ref": "#/$defs/property"
                          }
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "not": {
                        "properties": {
                          "type": { "const": "object" }
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "enum": {
                          "type": "array",
                          "items": {
                            "type": ["string", "number", "integer", "boolean"]
                          }
                        },
                        "enumNames": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                ]
              },
              "uniqueItems": {
                "type": "boolean",
                "default": false
              },
              "ui:placeholder": {
                "type": "array",
                "description": "The placeholder value of the field."
              },
              "ui:options": {
                "type": "object",
                "properties": {
                  "addable": {
                    "type": "boolean",
                    "default": true,
                    "description": "A boolean flag determining whether the user can click an 'Add' button to append new items to the array."
                  },
                  "removable": {
                    "type": "boolean",
                    "default": true,
                    "description": "A boolean flag determining whether individual items can be deleted from the array using a 'Remove' button."
                  },
                  "orderable": {
                    "type": "boolean",
                    "default": true,
                    "description": "A boolean flag enabling or disabling control buttons to shift array items up and down in sequence."
                  }
                }
              },
              "ui:widget": {
                "enum": ["checkboxes", "files"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "object" }
            }
          },
          "then": {
            "properties": {
              "properties": {
                "additionalProperties": {
                  "$ref": "#/$defs/property"
                }
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "type": { "const": "object" }
              }
            }
          },
          "then": {
            "properties": {
              "enum": {
                "type": "array",
                "description": "Enumeration of values to be selected by the user.",
                "items": {
                  "type": ["string", "number", "integer", "boolean", "array", "object"]
                }
              },
              "enumNames": {
                "type": "array",
                "description": "Aliases that will be shown in place of the enum values previously defined.",
                "items": {
                  "type": ["string", "number", "integer", "boolean", "array", "object"]
                }
              },
              "default": {
                "description": "The default value to be used.",
                "type": ["string", "number", "integer", "boolean", "array", "object"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ui:field": { "const": "RepoUrlPicker" }
            }
          },
          "then": {
            "properties": {
              "ui:options": {
                "type": "object",
                "properties": {
                  "allowedHosts": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "List of allowed SCM platform hosts."
                  },
                  "allowedOrganizations": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "List of allowed organizations in the given SCM platform."
                  },
                  "allowedOwners": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "List of allowed owners in the given SCM platform."
                  },
                  "allowedProjects": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "List of allowed projects in the given SCM platform."
                  },
                  "allowedRepos": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "List of allowed repos in the given SCM platform."
                  },
                  "requestUserCredentials": {
                    "type": "object",
                    "description": "If defined will request user credentials to auth against the given SCM platform.",
                    "properties": {
                      "secretName": {
                        "type": "string",
                        "description": "Key used within the template secrets context to store the credential."
                      },
                      "additionalScopes": {
                        "enum": ["gitea", "gerrit", "github", "gitlab", "bitbucket", "azure"],
                        "description": "Additional permission scopes to request."
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ui:field": { "enum": ["EntityPicker", "MultiEntityPicker"] }
            }
          },
          "then": {
            "properties": {
              "ui:options": {
                "type": "object",
                "properties": {
                  "catalogFilter": {
                    "type": "object",
                    "description": "An object containing key-value criteria or query operators used to filter which entities appear in the dropdown."
                  },
                  "allowArbitraryValues": {
                    "type": "boolean",
                    "description": "A boolean flag that allows users to type in and submit custom entity names not currently present in the software catalog."
                  },
                  "autoSelect": {
                    "type": "boolean",
                    "default": true,
                    "description": "A boolean flag that automatically selects the currently highlighted option when the input field loses focus."
                  },
                  "defaultKind": {
                    "type": "string",
                    "description": "The default entity kind fallback (e.g., Component) to assume if none is explicitly specified."
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
